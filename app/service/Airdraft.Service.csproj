<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AirdraftRadioService</AssemblyName>
    <RootNamespace>Airdraft.Service</RootNamespace>
    <Version>0.1.6</Version>
    <Product>Airdraft</Product>
    <Description>Airdraft: AirDrop on the built-in Intel Wi-Fi card (service)</Description>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RuntimeFrameworkVersion>8.0.28</RuntimeFrameworkVersion>
    <SelfContained>false</SelfContained>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>../assets/Airdraft.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ExperimentalRtl8852be)' == 'true'">
    <DefineConstants>$(DefineConstants);AIRDRAFT_RTL8852BE</DefineConstants>
    <Description>Airdraft: experimental AirDrop service for the RTL8852BE PCIe card</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>
